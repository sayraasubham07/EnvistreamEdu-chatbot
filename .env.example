# Backend Environment Variables
# Get free GROQ_API_KEY from https://console.groq.com/keys


# Optional: Override model
MODEL_ID=llama-3.1-8b-instant

# Firebase paths (already hardcoded, but can override)
# SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# ===== Frontend (Vite) variables — prefix MUST be VITE_ =====

# Required for Groq AI chat replies
VITE_GROQ_API_KEY=your_groq_api_key_here

# Optional: AI Speech-to-Text (Gemini) — the mic understands Hinglish perfectly
# and never mishears "Envistream EduSkill". Get a FREE key from
# https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Optional: Gemini model used for transcription (free model by default)
# VITE_GEMINI_MODEL=gemini-3.6-flash

