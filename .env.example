# Private Serverless API Key (Used on Vercel / server routes without exposing to the browser)
# Set GEMINI_API_KEY in Vercel Settings > Environment Variables
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Frontend fallback (Vite) variables
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.6-flash
